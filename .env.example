# Neo Configuration - Local Development & Cloud Deployment

# ============================================================================
# Neo Core Configuration
# ============================================================================

# Activity Log Storage Mode
# Options: "file" (default, local testing) or "supabase" (cloud production)
ACTIVITY_LOG_MODE=file

# Lock timeout in seconds (default: 1800 = 30 minutes)
NEO_LOCK_TIMEOUT=1800

# Multitenancy (for team isolation)
NEO_MULTITENANCY=false
CLAUDE_TENANT_ID=default

# ============================================================================
# NVIDIA NIM Configuration (Hackathon Integration)
# ============================================================================

# NVIDIA NIM endpoint
# Local development: http://localhost:8000
# Cloud: https://api.nims.nebius.ai/v1/... (or other cloud provider)
NVIDIA_NIM_ENDPOINT=http://localhost:8000

# NVIDIA API key (required for cloud endpoints, leave empty for local)
NVIDIA_NIM_API_KEY=

# NVIDIA model
NVIDIA_NIM_MODEL=nemotron-4-340b-instruct

# Model parameters
NVIDIA_NIM_MAX_TOKENS=2048
NVIDIA_NIM_TEMPERATURE=0.7
NVIDIA_NIM_TOP_P=0.9

# ============================================================================
# Supabase Configuration (Cloud Backend)
# ============================================================================

# Get these from https://app.supabase.com/
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ============================================================================
# Nebius Cloud Configuration (Hackathon Deployment)
# ============================================================================

# Nebius Token Factory / AI Cloud credentials
NEBIUS_API_TOKEN=
NEBIUS_PROJECT_ID=
NEBIUS_API_ENDPOINT=https://api.nebius.ai

# ============================================================================
# MCP Server Configuration
# ============================================================================

NEO_MCP_PORT=8000
NEO_MCP_HOST=0.0.0.0

# Rate Limiting (requests per minute)
NEO_RATE_LIMIT_REQUESTS=100
NEO_RATE_LIMIT_WINDOW_SECONDS=60

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Debug Mode
NEO_DEBUG=false
