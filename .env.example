# Neo Phase 2 Configuration - Cloud Deployment

# Activity Log Storage Mode
# Options: "file" (default, local testing) or "supabase" (cloud production)
ACTIVITY_LOG_MODE=file

# Supabase Configuration (only needed if ACTIVITY_LOG_MODE=supabase)
# Get these from https://app.supabase.com/
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key

# Multitenancy (for team isolation)
NEO_MULTITENANCY=false
CLAUDE_TENANT_ID=default

# MCP Server Configuration
NEO_MCP_PORT=8000
NEO_MCP_HOST=127.0.0.1

# Rate Limiting (requests per minute)
NEO_RATE_LIMIT_REQUESTS=100
NEO_RATE_LIMIT_WINDOW_SECONDS=60

# Debug Mode
NEO_DEBUG=false
